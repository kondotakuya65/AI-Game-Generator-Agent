# Application
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3002

# API
APP_PORT=8200

# LLM — ollama | openai | anthropic | mock
LLM_PROVIDER=mock
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi3:mini
LLM_TIMEOUT_SECONDS=180
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Pipeline
REPAIR_BUDGET=3
ARTIFACTS_DIR=../artifacts
# auto | mock | template — auto → mock when LLM_PROVIDER=mock
CODE_MODE=auto

# Frontend
API_PROXY_TARGET=http://localhost:8200
